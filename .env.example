# Copy this file to .env and fill in real values before running the application.
# .env is excluded from source control; never commit secrets.

# SQL Server sa password for the Docker container
MSSQL_SA_PASSWORD=

# Full connection string used by the API and EF Core design-time tooling.
# The password must match MSSQL_SA_PASSWORD above.
ConnectionStrings__DefaultConnection=Server=localhost,1433;Database=ClinicApp;User Id=sa;Password=;TrustServerCertificate=True;Encrypt=True

# JWT signing key (at least 32 bytes / ASCII characters)
Jwt__Key=

# Optional: SMTP settings for appointment email reminders
# Smtp__Host=
# Smtp__Port=587
# Smtp__Username=
# Smtp__Password=
# Smtp__From=
# Smtp__EnableSsl=true
